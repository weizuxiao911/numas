{
  "name": "docx",
  "displayName": "Docx Viewer",
  "description": "DOCX 阅读器 (vscode 自定义编辑器; fork 自 show-docx 1.2.1, MIT; 高保真渲染/主题适配)",
  "version": "1.2.2",
  "publisher": "numas",
  "license": "MIT",
  "author": {
    "name": "Aşır Can Aslan"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/showdocx/show-docx.git"
  },
  "homepage": "https://github.com/showdocx/show-docx#readme",
  "bugs": {
    "url": "https://github.com/showdocx/show-docx/issues"
  },
  "engines": {
    "vscode": "^1.85.0",
    "opensumi": "^3.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Docx renders documents in a sandboxed webview with a strict CSP. In a restricted workspace it will not open links a document points to."
    }
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "docx",
    "word",
    "office",
    "viewer",
    "preview",
    "document"
  ],
  "activationEvents": [
    "onCustomEditor:docx.docxViewer",
    "onCommand:docx.openWith",
    "onCommand:docx.compareWithHead",
    "onCommand:docx.extractImages",
    "onCommand:docx.searchWorkspace",
    "onCommand:docx.writeMarkdownMirror",
    "onCommand:docx.showLog",
    "onLanguageModelTool:docx_readDocx"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "docx.docxViewer",
        "displayName": "Word Document Viewer",
        "selector": [
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.docm"
          },
          {
            "filenamePattern": "*.dotx"
          },
          {
            "filenamePattern": "*.dotm"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "docx.openWith",
        "title": "Open with Docx",
        "category": "Docx"
      },
      {
        "command": "docx.compareWithHead",
        "title": "Compare with HEAD",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer || resourceExtname == .docx || resourceExtname == .docm || resourceExtname == .dotx || resourceExtname == .dotm"
      },
      {
        "command": "docx.exportHtml",
        "title": "Export as HTML",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.exportMarkdown",
        "title": "Export as Markdown",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.exportPdf",
        "title": "Print to PDF (via Browser)",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.copyAsMarkdown",
        "title": "Copy as Markdown",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.copyAsText",
        "title": "Copy as Plain Text",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.search",
        "title": "Find in Document",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.searchWorkspace",
        "title": "Search in Word Documents",
        "category": "Docx"
      },
      {
        "command": "docx.showProperties",
        "title": "Show Document Properties",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.extractImages",
        "title": "Extract Images",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer || resourceExtname == .docx || resourceExtname == .docm || resourceExtname == .dotx || resourceExtname == .dotm"
      },
      {
        "command": "docx.writeMarkdownMirror",
        "title": "Write Markdown Mirrors",
        "category": "Docx"
      },
      {
        "command": "docx.zoomIn",
        "title": "Zoom In",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.zoomOut",
        "title": "Zoom Out",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.zoomReset",
        "title": "Reset Zoom",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.fitToWidth",
        "title": "Fit Page to Width",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.fitToPage",
        "title": "Fit Whole Page",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.toggleMode",
        "title": "Toggle Visual/Text Mode",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.cyclePageTheme",
        "title": "Change Page Theme",
        "category": "Docx",
        "enablement": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.showLog",
        "title": "Show Log",
        "category": "Docx"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "docx.openWith",
          "when": "resourceExtname == .docx || resourceExtname == .docm || resourceExtname == .dotx || resourceExtname == .dotm",
          "group": "navigation@20"
        },
        {
          "command": "docx.compareWithHead",
          "when": "resourceExtname == .docx || resourceExtname == .docm || resourceExtname == .dotx || resourceExtname == .dotm",
          "group": "navigation@21"
        },
        {
          "command": "docx.extractImages",
          "when": "resourceExtname == .docx || resourceExtname == .docm || resourceExtname == .dotx || resourceExtname == .dotm",
          "group": "navigation@22"
        }
      ],
      "editor/title": [
        {
          "command": "docx.compareWithHead",
          "when": "activeCustomEditorId == docx.docxViewer",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "docx.search",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.zoomReset",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeCustomEditorId == docx.docxViewer"
      },
      {
        "command": "docx.exportPdf",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "activeCustomEditorId == docx.docxViewer"
      }
    ],
    "configuration": {
      "title": "Docx",
      "properties": {
        "docx.defaultMode": {
          "type": "string",
          "default": "visual",
          "enum": [
            "visual",
            "text"
          ],
          "enumDescriptions": [
            "Preserve the Word page layout.",
            "Show clean, theme-aware semantic HTML."
          ],
          "description": "Default rendering mode."
        },
        "docx.defaultZoom": {
          "type": "number",
          "default": 100,
          "minimum": 25,
          "maximum": 400,
          "description": "Default zoom level in percent."
        },
        "docx.defaultPageTheme": {
          "type": "string",
          "default": "paper",
          "enum": [
            "paper",
            "sepia",
            "dark"
          ],
          "enumDescriptions": [
            "White, the way Word shows the page.",
            "A warm, low-contrast ground for long reading.",
            "Invert the page so it suits a dark editor. Images are left as they are."
          ],
          "description": "Background of the page in Visual mode. Text mode always follows the editor theme."
        },
        "docx.maxFileSizeMb": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum DOCX file size that Docx will open."
        },
        "docx.autoReload": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reload the preview when the DOCX file changes on disk."
        },
        "docx.retainHiddenTabs": {
          "type": "boolean",
          "default": false,
          "description": "Keep a document rendered while its tab is hidden. Returning to the tab is then instant, at the cost of holding the whole document and its rendered page in memory for every open tab. Leaving this off costs one re-render on return; the reading position is restored either way. Takes effect after the window is reloaded."
        },
        "docx.exportLocation": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "alongside"
          ],
          "enumDescriptions": [
            "Choose where each export goes, in a save dialog.",
            "Write the export next to the document, under the same name, without asking."
          ],
          "description": "Where HTML, Markdown and printable exports are written."
        },
        "docx.markdownMirror": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "onChange"
          ],
          "enumDescriptions": [
            "Do not keep Markdown mirrors up to date.",
            "Rewrite a mirror when its document changes on disk. Only mirrors that already exist are updated; run \"Docx: Write Markdown Mirrors\" to create them."
          ],
          "description": "Keep a .md mirror of a document up to date, so git and code review can read what changed in it. Docx never creates a mirror on its own."
        },
        "docx.markdownMirrorDirectory": {
          "type": "string",
          "default": "",
          "description": "Where Markdown mirrors are written, relative to the workspace folder. Empty writes each mirror beside its document."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "showdocx_readDocx",
        "displayName": "Read Word document",
        "toolReferenceName": "docx",
        "canBeReferencedInPrompt": true,
        "icon": "$(file-word)",
        "userDescription": "Read the text of a Word (.docx) document in this workspace.",
        "modelDescription": "Read the text content of a Word (.docx) document in the current workspace. Use this whenever you need the contents of a .docx file: reading it directly returns a binary ZIP archive, not text. Returns Markdown: headings, lists, tables and links are preserved; embedded images are replaced by a short placeholder. Deletions in tracked changes are not included, and insertions appear as accepted. Only documents inside the open workspace can be read.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Path of the .docx file, either absolute or relative to a workspace folder."
            },
            "maxCharacters": {
              "type": "number",
              "description": "Maximum number of characters to return. Defaults to 60000. If the document is longer the result is cut at a line boundary and says how much was left out."
            }
          },
          "required": [
            "filePath"
          ]
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "showdocx.docx",
        "name": "docx",
        "fullName": "Docx",
        "description": "Ask about the Word document you have open",
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run verify && npm run build",
    "build": "node ./esbuild.mjs",
    "watch": "node ./esbuild.mjs --watch",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src shared webview-src test scripts",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile-tests && mocha \"dist-test/test/unit/**/*.test.js\"",
    "test:integration": "npm run build && npm run compile-tests && node ./scripts/run-tests.mjs",
    "test:webview": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "verify": "npm run lint && npm run check-types && npm run test:unit && npm run test:integration && npm run test:webview",
    "generate:fixtures": "node ./scripts/generate-fixtures.mjs",
    "generate:notices": "node ./scripts/generate-notices.mjs",
    "verify:package-files": "node ./scripts/verify-package-files.mjs",
    "package": "npm run build && node scripts/package.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "buffer": "^6.0.3",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.3.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "path-browserify": "^1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.25",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "docx": "^9.7.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "mocha": "^11.3.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  },
  "browser": "./dist/extension.js"
}
