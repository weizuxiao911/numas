{
  "name": "pdf",
  "displayName": "PDF Viewer",
  "description": "PDF 阅读器 (vscode 自定义编辑器 + pdf.js 渲染; pdfjs 静态资源随 vsix 打包, 不依赖 CDN)",
  "version": "0.1.5",
  "publisher": "numas",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:pdfViewer",
    "onCommand:pdf.open"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "pdfViewer",
        "displayName": "PDF Viewer (vsix)",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "pdf",
        "extensions": [
          ".pdf"
        ],
        "aliases": [
          "PDF"
        ]
      }
    ],
    "commands": [
      {
        "command": "pdf.open",
        "title": "Open PDF",
        "category": "PDF"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile:bundle": "node esbuild.config.mjs",
    "build": "npm run clean && npm run compile:bundle",
    "package": "npm run build && node scripts/package.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.4"
  }
}
