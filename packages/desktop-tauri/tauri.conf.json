{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "numas",
  "version": "0.1.8",
  "identifier": "dev.numas.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:4096",
    "beforeBuildCommand": "",
    "frontendDist": "../desktop-tauri/assets"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "numas",
        "url": "http://localhost:4096",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "numas"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/numas"
    ],
    "resources": [],
    "category": "DeveloperTool",
    "shortDescription": "Numas AI workspace",
    "longDescription": "Numas desktop shell — Tauri tray/window around numas CLI + codeblitz web UI."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["numas"]
      }
    }
  }
}