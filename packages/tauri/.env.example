# macOS 签名 + 公证凭据 (复制为 .env.local, 不要提交)
# Bun 会自动加载同目录的 .env.local

# Developer ID Application 证书名 (钥匙串里 security find-identity -v -p codesigning 可见)
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# 公证方式 A: Apple ID + 专用密码 (appleid.apple.com 生成) + Team ID
APPLE_ID="you@example.com"
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
APPLE_TEAM_ID="TEAMID"

# 公证方式 B: App Store Connect API Key (二选一, 与 A 不共存)
# APPLE_API_KEY="/absolute/path/AuthKey_XXXX.p8"
# APPLE_API_KEY_ID="XXXX"
# APPLE_API_ISSUER="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
