{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "numas",
  "version": "0.0.0",
  "identifier": "dev.numas.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "assets"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/numas"],
    "category": "DeveloperTool",
    "shortDescription": "Numas AI workspace",
    "longDescription": "Numas desktop shell: tray + numas:// scheme around the bundled numas server."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["numas"]
      }
    }
  }
}
