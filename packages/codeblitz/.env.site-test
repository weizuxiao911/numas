# 独立部署 - 测试环境 (DEPLOY_ENV=site-test → 测试云构建)
# 与 .env.site 同结构, 仅 LOGIN_REDIRECT 指向测试云登录页.
APP_BASE_URL=http://127.0.0.1:24096
REGISTRY_BASE_URL=http://127.0.0.1:24096/extensions
# 登录门槛 (独立部署): 未登录 → {LOGIN_REDIRECT}{encodeURIComponent(当前URL)}&needToken=true
LOGIN_REDIRECT=https://test.cloudlab.top/login?redirect=
